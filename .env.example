# ------------------------------------------------------------------
# Environment variables. Copy to `.env.local` and fill in.
# NEVER commit real values or tokens. `.env*.local` is gitignored.
# ------------------------------------------------------------------

# --- Sanity CMS (content) -----------------------------------------
# From your Sanity project (sanity.io → project → API). Safe to expose
# (public, read-only content). Required to read content from Sanity;
# if unset, the site falls back to local seed data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Optional: a Sanity read token ONLY if you later enable draft/preview
# mode (server-side). Keep it SECRET — do not prefix with NEXT_PUBLIC.
# SANITY_API_READ_TOKEN=

# --- Site --------------------------------------------------------
# Your public site URL (used for canonical/OG/sitemap). Set in prod.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Enquiry delivery (optional; from Phase 6) --------------------
# Email via Resend (leave unset to just log leads server-side):
# RESEND_API_KEY=
# ENQUIRY_TO_EMAIL=you@example.com
# ENQUIRY_FROM_EMAIL=Enquiries <onboarding@resend.dev>
# Generic webhook → CRM / WhatsApp automation (Zapier/Make/n8n):
# ENQUIRY_WEBHOOK_URL=
